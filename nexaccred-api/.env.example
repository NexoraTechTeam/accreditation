# --- NexAccred API ---
PORT=3001

# Local Postgres (see nexaccred-api/README.md for how this instance was provisioned —
# a dedicated Postgres.app cluster on port 5433, isolated from any other project's DB)
DATABASE_URL="postgresql://nexaccred@127.0.0.1:5433/nexaccred?schema=public"

# --- AIHCM integration (real system, see 03-Data-Model-NexAccred.md §1.5) ---
AIHCM_BASE_URL="http://localhost:8080"
AIHCM_TENANT_CODE="demo-id"
AIHCM_LOGIN_EMAIL="admin@demo.aihcm.local"
AIHCM_LOGIN_PASSWORD="ChangeMe123!"

# --- Platform Audit integration (no live app yet — stub adapter is used regardless of this URL) ---
PLATFORM_AUDIT_BASE_URL="http://localhost:9090"
PLATFORM_AUDIT_ENABLED="false"
